<?xml version="1.0" encoding="utf-8"?>
<!--
  U's complete manifest — mirrors the one cargo-apk generates, plus the
  one line metadata cannot say: USE_BIOMETRIC, the normal (install-time,
  never runtime-prompted) permission the fingerprint lock needs. Everything
  else is what `[package.metadata.android]` would have produced:
  NativeActivity loading the `u` cdylib, the NoActionBar theme the app
  draws straight over, portrait, and the launcher intent.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.vieww.u">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:label="U"
        android:icon="@drawable/u_icon"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:hasCode="true">
        <activity
            android:name="android.app.NativeActivity"
            android:label="U"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|screenLayout|density">
            <meta-data
                android:name="android.app.lib_name"
                android:value="u" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
